{
  "phoneEnrichment": {
    "providerOrder": ["orionConnect", "astraDialer", "nimbusLookup"],
    "workflowTimeoutMs": 300000,
    "defaultRetry": {
      "maximumAttempts": 3,
      "initialIntervalMs": 1000,
      "backoffCoefficient": 2,
      "maximumIntervalMs": 10000
    },
    "providers": {
      "orionConnect": {
        "displayName": "Orion Connect",
        "enabled": true,
        "url": "https://api.enginy.ai/api/tmp/orionConnect",
        "method": "POST",
        "timeoutMs": 8000,
        "auth": { "type": "header", "name": "x-auth-me" },
        "request": { "fullName": "{{fullName}}", "companyWebsite": "{{companyWebsite}}" },
        "response": { "phonePath": "phone" }
      },
      "astraDialer": {
        "displayName": "Astra Dialer",
        "enabled": true,
        "url": "https://api.enginy.ai/api/tmp/astraDialer",
        "method": "POST",
        "timeoutMs": 2000,
        "auth": { "type": "header", "name": "apiKey" },
        "request": { "email": "{{email}}" },
        "response": { "phonePath": "phoneNmbr" }
      },
      "nimbusLookup": {
        "displayName": "Nimbus Lookup",
        "enabled": true,
        "url": "https://api.enginy.ai/api/tmp/numbusLookup",
        "method": "POST",
        "timeoutMs": 5000,
        "auth": { "type": "query", "name": "api" },
        "request": { "email": "{{email}}", "jobTitle": "{{jobTitle}}" },
        "response": { "phonePath": "phoneNmbr" }
      }
    }
  }
}
