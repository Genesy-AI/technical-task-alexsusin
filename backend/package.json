{
  "name": "interview-take-home-c-backend",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --dir ../shared install && pnpm shared:build",
    "shared:build": "pnpm --dir ../shared build",
    "start": "node ./dist/index.js",
    "dev": "pnpm shared:build && nodemon ./src/index.ts",
    "build": "pnpm shared:build && tsc -p .",
    "format": "prettier --write .",
    "gen:prisma": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "test": "pnpm shared:build && vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@temporalio/testing": "1.13.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "@vitest/ui": "^3.2.4",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@temporalio/activity": "1.13.0",
    "@temporalio/client": "^1.13.0",
    "@temporalio/worker": "^1.13.0",
    "@temporalio/workflow": "^1.13.0",
    "@tinyenginy/shared": "link:../shared",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  }
}
